# Immich image tag
IMMICH_VERSION=release

# Timezone
TZ=Asia/Tokyo

# PostgreSQL settings
DB_USERNAME=postgres
# Do not start the stack until you replace this with your own long, unique password.
DB_PASSWORD=REPLACE_WITH_A_SECURE_PASSWORD_MINIMUM_32_CHARS
DB_DATABASE_NAME=immich

# Internal SSD paths
# Replace `username` with your macOS account name.
# Docker Compose will create these directories automatically if they do not exist.
POSTGRES_DATA_PATH=/Users/username/immich-app/postgres
THUMBNAILS_PATH=/Users/username/immich-app/thumbs
PROFILE_PATH=/Users/username/immich-app/profile
VIDEO_CACHE_PATH=/Users/username/immich-app/encoded-video
UPLOAD_BACKUP_PATH=/Users/username/immich-app/backups
ML_CACHE_PATH=/Users/username/immich-app/ml-cache

# External HDD path for original photos and videos
# Make sure the external volume is mounted before starting Docker Compose.
# Replace `Immich_Live` with the actual name of your external HDD volume.
LIBRARY_PATH=/Volumes/Immich_Live/immich-data/library
