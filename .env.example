# Immich のイメージタグ
IMMICH_VERSION=v2

# タイムゾーン
TZ=Asia/Tokyo

# PostgreSQL の設定
DB_USERNAME=postgres
# TODO: 必ず自分用の長く一意なパスワードに置き換えてからスタックを起動してください。
DB_PASSWORD=REPLACE_WITH_A_SECURE_PASSWORD_MINIMUM_32_CHARS
DB_DATABASE_NAME=immich

# 内蔵 SSD のパス
# これらのディレクトリが存在しない場合、Docker Compose が自動で作成します。
# TODO: `username` を macOS のアカウント名に置き換えてください。
IMMICH_APP_PATH=/Users/USERNAME/immich-app
DB_DATA_LOCATION=/Users/USERNAME/immich-app/postgres
THUMB_LOCATION=/Users/USERNAME/immich-app/thumbs
PROFILE_LOCATION=/Users/USERNAME/immich-app/profile
ENCODED_VIDEO_LOCATION=/Users/USERNAME/immich-app/encoded-video # 内蔵SSD推奨: 動画再生までがスムーズになる

# 元の写真と動画を保存する外付け HDD のパス
# TODO: Docker Compose を起動する前に、外付けボリュームがマウントされていることを確認してください。
# TODO: `Immich_Live` を実際の外付け HDD ボリューム名に置き換えてください。
UPLOAD_LOCATION=/Volumes/VOLUME_NAME/immich-data
BACKUP_LOCATION=/Volumes/VOLUME_NAME/immich-data/backups
ML_CACHE_LOCATION=/Volumes/VOLUME_NAME/immich-data/ml-cache

# rclone バックアップ設定（Backblaze B2）
B2_KEY_ID=
B2_APPLICATION_KEY=

# Immich バックアップ対象
# コンテナ内パスを指定します。ホスト側の写真・動画は LIBRARY_PATH として /data/library に読み込み専用でマウントされます。
KOKI_BACKUP_TEST_ENABLED=false
KOKI_BACKUP_TEST_SOURCE=/data/library/admin/2026
KOKI_BACKUP_TEST_DEST=b2:immich-koki/admin/2026
KOKI_BACKUP_PRODUCTION_ENABLED=true
KOKI_BACKUP_PRODUCTION_SOURCE=/data/library/admin
KOKI_BACKUP_PRODUCTION_DEST=b2:immich-koki
KOKI_BACKUP_SETTINGS_ENABLED=true
KOKI_BACKUP_SETTINGS_SOURCE=/data/settings
KOKI_BACKUP_SETTINGS_DEST=b2:immich-settings

# TODO: `mie` を Immich の実ディレクトリ名に置き換えてください。
MIE_BACKUP_TEST_ENABLED=false
MIE_BACKUP_TEST_SOURCE=/data/library/mie/2026
MIE_BACKUP_TEST_DEST=b2:immich-mie/mie/2026
MIE_BACKUP_PRODUCTION_ENABLED=true
MIE_BACKUP_PRODUCTION_SOURCE=/data/library/mie
MIE_BACKUP_PRODUCTION_DEST=b2:immich-mie
MIE_BACKUP_SETTINGS_ENABLED=false
MIE_BACKUP_SETTINGS_SOURCE=
MIE_BACKUP_SETTINGS_DEST=

# Smart Ranker の任意設定
# TODO: Smart Ranker を使う場合だけ設定してください。
# ## Smart Ranker は Docker Compose network 内で Immich API と PostgreSQL へ接続します。
# SMART_RANKER_PORT=8010
# SMART_RANKER_IMMICH_API_KEY=
# SMART_RANKER_IMMICH_USER_ID=

## 任意: Review アルバム追加と閾値
# SMART_RANKER_REVIEW_ALBUM_ID=
# SMART_RANKER_REVIEW_THRESHOLD=0.5

# Immich Cleaner の任意設定
# TODO: Immich Cleaner を使う場合だけ設定してください。
IMMICH_CLEANER_KOKI_PORT=2293
IMMICH_CLEANER_KOKI_IMMICH_API_KEY=
IMMICH_CLEANER_MIE_PORT=2294
IMMICH_CLEANER_MIE_IMMICH_API_KEY=

## Immich の現行 API は DELETE /api/assets でゴミ箱へ移動します。
## 古い API に合わせる場合は PUT に切り替えてください。
IMMICH_CLEANER_TRASH_METHOD=DELETE
IMMICH_CLEANER_TRASH_FORCE=false
IMMICH_CLEANER_USE_POLLING=false
