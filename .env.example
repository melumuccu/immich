# TODO: `{USER_NAME}` を macOS のアカウント名に置き換えてください。
# TODO: `{VOLUME_NAME}` を実際の外付け HDD ボリューム名に置き換えてください。
TZ=Asia/Tokyo

#==================================
# PostgreSQL
#==================================
DB_USERNAME=postgres
DB_PASSWORD={REPLACE_WITH_A_SECURE_PASSWORD_MINIMUM_32_CHARS} # TODO: 自分用の長く一意なパスワードに置換
DB_DATABASE_NAME=immich

#==================================
# Immich Server
#==================================
# see: ~/README.md#外付け HDD ・内蔵 SSD のどちらに保存するかの判断基準
# see: https://docs.immich.app/install/environment-variables/
IMMICH_VERSION=v2
UPLOAD_LOCATION=/Volumes/{VOLUME_NAME}/immich-data
DB_DATA_LOCATION=/Users/{USER_NAME}/immich-app/postgres
# see: https://docs.immich.app/guides/custom-locations
THUMB_LOCATION=/Users/{USER_NAME}/immich-app/thumbs
ENCODED_VIDEO_LOCATION=/Volumes/{VOLUME_NAME}/immich-data/encoded-video
PROFILE_LOCATION=/Volumes/{VOLUME_NAME}/immich-data/profile
BACKUP_LOCATION=/Volumes/{VOLUME_NAME}/immich-data/backups # see: https://docs.immich.app/administration/backup-and-restore/#filesystem 

#==================================
# Immich ML
#==================================
ML_CACHE_LOCATION=/Volumes/{VOLUME_NAME}/immich-data/ml-cache

#==================================
# Immich Backup (独自)
#==================================
IMMICH_APP_PATH=/Users/{USER_NAME}/immich-app
# rclone バックアップ設定（Backblaze B2）
B2_KEY_ID=
B2_APPLICATION_KEY=
# KOKI
KOKI_BACKUP_CRON="30 2 * * *"
KOKI_BACKUP_MODE=prod
KOKI_BACKUP_TEST_SOURCE=/data/library/admin/2026
KOKI_BACKUP_TEST_DEST=b2:immich-koki/admin/2026
KOKI_BACKUP_PROD_SOURCE=/data/library/admin
KOKI_BACKUP_PROD_DEST=b2:immich-koki
# MIE
MIE_BACKUP_CRON="0 3 * * *"
MIE_BACKUP_MODE=prod
MIE_BACKUP_TEST_SOURCE=/data/library/mie/2026
MIE_BACKUP_TEST_DEST=b2:immich-mie/mie/2026
MIE_BACKUP_PROD_SOURCE=/data/library/mie
MIE_BACKUP_PROD_DEST=b2:immich-mie
# SETTINGS
SETTINGS_BACKUP_CRON="0 2 * * *"
SETTINGS_BACKUP_ENABLED=true
SETTINGS_BACKUP_SOURCE=/data/settings
SETTINGS_BACKUP_DEST=b2:immich-settings

#==================================
# Immich Cleaner (独自)
#==================================
IMMICH_CLEANER_TRASH_METHOD=DELETE
IMMICH_CLEANER_TRASH_FORCE=false
IMMICH_CLEANER_USE_POLLING=false
# KOKI
IMMICH_CLEANER_KOKI_PORT=2293
IMMICH_CLEANER_KOKI_IMMICH_API_KEY=
# MIE
IMMICH_CLEANER_MIE_PORT=2294
IMMICH_CLEANER_MIE_IMMICH_API_KEY=

#==================================
# Smart Ranker (独自)
#==================================
# ## Smart Ranker は Docker Compose network 内で Immich API と PostgreSQL へ接続します。
# SMART_RANKER_PORT=8010
# SMART_RANKER_IMMICH_API_KEY=
# SMART_RANKER_IMMICH_USER_ID=
## 任意: Review アルバム追加と閾値
# SMART_RANKER_REVIEW_ALBUM_ID=
# SMART_RANKER_REVIEW_THRESHOLD=0.5
